<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NOTE: CONS-001 requires Domain to reference no NuGet outside BCL.
       ApplicationUser inherits IdentityUser<string>. In .NET 8 the
       IdentityUser type lives in Microsoft.AspNetCore.Identity.EntityFrameworkCore,
       so this minimal reference is required for compilation. No EF Core
       DbContext / validation packages here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.5" />
  </ItemGroup>

</Project>
